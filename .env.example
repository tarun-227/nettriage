# NetTriage needs no secrets. Every setting is optional; the defaults are shown, commented out.
# Uncomment only what you want to change. On Railway, host and port come from the platform.

# Address the web UI listens on. Keep it on loopback unless you know why not.
# NETTRIAGE_HOST=127.0.0.1
# NETTRIAGE_PORT=8765

# Largest capture accepted, in megabytes.
# NETTRIAGE_MAX_UPLOAD_MB=500

# Stop parsing after this many packets.
# NETTRIAGE_MAX_PACKETS=5000000

# Kill an analysis that runs longer than this many seconds.
# NETTRIAGE_MAX_ANALYSIS_SECONDS=300

# Forget finished reports after this many minutes.
# NETTRIAGE_RESULT_TTL_MINUTES=60
